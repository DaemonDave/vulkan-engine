      m = n >> 1;
      c01 = ((&p[0])->y0 < (&p[m])->y0);
      c12 = ((&p[m])->y0 < (&p[n-1])->y0);

      if (c01 != c12) {

         int z;
         c = ((&p[0])->y0 < (&p[n-1])->y0);


         z = (c == c12) ? 0 : n-1;
         t = p[z];
         p[z] = p[m];
         p[m] = t;
      }


      t = p[0];
      p[0] = p[m];
      p[m] = t;


      i=1;
      j=n-1;
      for(;;) {


         for (;;++i) {
            if (!((&p[i])->y0 < (&p[0])->y0)) break;
         }
         for (;;--j) {
            if (!((&p[0])->y0 < (&p[j])->y0)) break;
         }

         if (i >= j) break;
         t = p[i];
         p[i] = p[j];
         p[j] = t;

         ++i;
         --j;
      }

      if (j < (n-i)) {
         stbtt__sort_edges_quicksort(p,j);
         p = p+i;
         n = n-i;
      } else {
         stbtt__sort_edges_quicksort(p+i, n-i);
         n = j;
      }
   }
}

static void stbtt__sort_edges(stbtt__edge *p, int n)
{
